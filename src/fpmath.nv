// fpmath — the single-precision functions a device with no libm needs,
// written in `+ - * /` and comparisons.
//
// WHY THEY ARE HERE.  `@tier(embedded)` refuses `math.sqrt`,
// `math.sin`, `math.cos`, `math.atan2` and the rest, because each
// lowers to a call into the C maths library, which a 64 KB image
// cannot link.  A filter needs a square root to normalise, a sine and a
// cosine to build a rotation, and an arctangent and an arcsine to read a
// rotation back as angles.  The routines below are the ones Cephes
// (S. L. Moshier) gives for binary32: a reduction of the argument to a
// short interval and a polynomial over it.  `tests/fpmath_tests.nv`
// measures each against the host's `math` over a dense sweep of the
// stated domain and asserts the bound stated here.
//
// THE ACCURACY IS THE CONTRACT.  Each function states its absolute (or,
// for the roots, relative) error bound, which is the bound the tests
// assert, and which is a few units in the last place of a binary32 over
// the domain.  The measured maxima are in the README.
//
// `fp32` arithmetic is rounded to binary32 after every operation.  A
// literal beside an `fp32` makes the operation binary64, which a
// Cortex-M4 does in software, so every constant below is bound to a
// typed `let` first.
//
// THE SQUARE ROOT.  `sqrt` and `inv_sqrt` are Newton iterations over a
// bit-pattern estimate, because the embedded tier has no `math.sqrt` on an
// `fp32`.  The one line to change when it has is the last line of `sqrt`:
// `s + half * (x - s * s) * r` becomes `math.sqrt(x)`, and `inv_sqrt`
// becomes `one / math.sqrt(x)`; nothing else in this module or in a
// package that calls it changes.

// The reciprocal square root of `x`, for `x > 0`; zero for `x <= 0`.
//
// A bit-pattern estimate good to about three per cent, then three
// Newton steps in binary32, which carry it to the last place.  Relative
// error at most 2e-7.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let r = fpmath.inv_sqrt(4.0)
//     println("${r > 0.4999999 and r < 0.5000001}")   // true
// ```
pub fn inv_sqrt(x: fp32) -> fp32 []
    let zero: fp32 = 0.0
    if x <= zero
        return zero
    let half: fp32 = 0.5
    let three_halves: fp32 = 1.5
    let guess = float.from_bits(0x5fe6eb50c7b537a9 - (float.to_bits(x as Float) >> 1))
    var y = guess as fp32
    for step in 0..3
        y = y * (three_halves - half * x * y * y)
    y

// The square root of `x`, for `x >= 0`; zero for `x < 0`.
//
// Relative error at most 2e-7: `x` times its reciprocal root, with one
// more Newton step on the product so the result is rounded once.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let r = fpmath.sqrt(2.0)
//     println("${r > 1.414213 and r < 1.414214}")   // true
// ```
pub fn sqrt(x: fp32) -> fp32 []
    let zero: fp32 = 0.0
    if x <= zero
        return zero
    let half: fp32 = 0.5
    let r = inv_sqrt(x)
    let s = x * r
    s + half * (x - s * s) * r

// The constants of the reduction by a quarter turn, in three parts so
// that `n * (pi / 2)` loses nothing for an `n` of a few hundred.
fn pio2_hi() -> fp32 []
    1.5703125

fn pio2_mid() -> fp32 []
    0.0004837512969970703

fn pio2_lo() -> fp32 []
    7.549789948768648e-8

// The nearest whole number of quarter turns to `x`.
fn quarter_turns(x: fp32) -> Int []
    let zero: fp32 = 0.0
    let two_over_pi: fp32 = 0.6366197723675814
    let half: fp32 = 0.5
    let t = x * two_over_pi
    if t < zero
        return (t - half) as Int
    (t + half) as Int

// `x` less `n` quarter turns, in `[-pi/4, pi/4]`.
fn reduce(x: fp32, n: Int) -> fp32 []
    let k = n as fp32
    x - k * pio2_hi() - k * pio2_mid() - k * pio2_lo()

// `sin(r)` for `r` in `[-pi/4, pi/4]`.
fn sin_poly(r: fp32) -> fp32 []
    let c1: fp32 = -1.9515295891e-4
    let c2: fp32 = 8.3321608736e-3
    let c3: fp32 = -1.6666654611e-1
    let z = r * r
    ((c1 * z + c2) * z + c3) * z * r + r

// `cos(r)` for `r` in `[-pi/4, pi/4]`.
fn cos_poly(r: fp32) -> fp32 []
    let c1: fp32 = 2.443315711809948e-5
    let c2: fp32 = -1.388731625493765e-3
    let c3: fp32 = 4.166664568298827e-2
    let half: fp32 = 0.5
    let one: fp32 = 1.0
    let z = r * r
    ((c1 * z + c2) * z + c3) * z * z - half * z + one

// The sine of `x`, in radians.
//
// Absolute error at most 2e-7 for `|x| <= 100`.  The argument is
// reduced by whole quarter turns, so a larger angle is as accurate as
// its own rounding allows.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let s = fpmath.sin(1.5707964)
//     println("${s > 0.999999 and s < 1.000001}")   // true
// ```
pub fn sin(x: fp32) -> fp32 []
    let n = quarter_turns(x)
    let r = reduce(x, n)
    let q = n & 3
    if q == 0
        return sin_poly(r)
    if q == 1
        return cos_poly(r)
    if q == 2
        return -sin_poly(r)
    -cos_poly(r)

// The cosine of `x`, in radians.
//
// Absolute error at most 2e-7 for `|x| <= 100`.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let c = fpmath.cos(0.0)
//     println("${c}")   // 1
// ```
pub fn cos(x: fp32) -> fp32 []
    let n = quarter_turns(x)
    let r = reduce(x, n)
    let q = n & 3
    if q == 0
        return cos_poly(r)
    if q == 1
        return -sin_poly(r)
    if q == 2
        return -cos_poly(r)
    sin_poly(r)

// The arctangent of `x` in `(-pi/2, pi/2)`.
//
// Absolute error at most 3e-7.  The argument is folded into
// `[-tan(pi/8), tan(pi/8)]` by `atan(x) = pi/2 - atan(1/x)` and
// `atan(x) = pi/4 + atan((x - 1)/(x + 1))`, and a polynomial finishes.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let a = fpmath.atan(1.0)
//     println("${a > 0.785398 and a < 0.785399}")   // true
// ```
pub fn atan(x: fp32) -> fp32 []
    let zero: fp32 = 0.0
    let one: fp32 = 1.0
    let a = if x < zero
        -x
    else
        x
    let pio2: fp32 = 1.5707963267948966
    let pio4: fp32 = 0.7853981633974483
    let t3pio8: fp32 = 2.414213562373095
    let tpio8: fp32 = 0.4142135623730950
    let big = a > t3pio8
    let mid = a > tpio8
    let base = if big
        pio2
    else
        if mid
            pio4
        else
            zero
    let u = if big
        -(one / a)
    else
        if mid
            (a - one) / (a + one)
        else
            a
    let c1: fp32 = 8.05374449538e-2
    let c2: fp32 = -1.38776856032e-1
    let c3: fp32 = 1.99777106478e-1
    let c4: fp32 = -3.33329491539e-1
    let z = u * u
    let r = base + ((((c1 * z + c2) * z + c3) * z + c4) * z * u + u)
    if x < zero
        return -r
    r

// The angle of the point `(x, y)` from the positive x axis, in
// `(-pi, pi]`; `atan2(0, 0)` is zero.  Note the order: `y` first.
//
// Absolute error at most 3e-7.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let a = fpmath.atan2(1.0, -1.0)
//     println("${a > 2.356194 and a < 2.356195}")   // true
// ```
pub fn atan2(y: fp32, x: fp32) -> fp32 []
    let zero: fp32 = 0.0
    let pi: fp32 = 3.141592653589793
    let pio2: fp32 = 1.5707963267948966
    if x > zero
        return atan(y / x)
    if x < zero
        if y >= zero
            return atan(y / x) + pi
        return atan(y / x) - pi
    if y > zero
        return pio2
    if y < zero
        return -pio2
    zero

// The arcsine of `x` in `[-pi/2, pi/2]`; `x` outside `[-1, 1]` is
// clamped to it.
//
// Absolute error at most 3e-7 over the whole interval.  The root is of
// `(1 - x) * (1 + x)`, which keeps the digits near the ends that `1 - x * x`
// would round away.
//
// ```novo
// use fpmath
//
// fn main() [io]
//     let a = fpmath.asin(0.5)
//     println("${a > 0.523598 and a < 0.523599}")   // true
// ```
pub fn asin(x: fp32) -> fp32 []
    let one: fp32 = 1.0
    var c = x
    if c > one
        c = one
    if c < -one
        c = -one
    atan2(c, sqrt((one - c) * (one + c)))
